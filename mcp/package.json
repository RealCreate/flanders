{
  "name": "flanders-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Headless MCP server for Flanders: an AI agent plays the real game core in-process, with no browser and no UI, in very few tokens",
  "bin": {
    "flanders-mcp": "server.mjs"
  },
  "scripts": {
    "wasm": "wasm-pack build ../crates/game-core --target nodejs --release --out-dir ../../mcp/wasm && node -e \"require('fs').writeFileSync('wasm/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "start": "node server.mjs",
    "test": "node test/guardrails.test.mjs && node --test test/engine.test.mjs test/server.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  }
}
